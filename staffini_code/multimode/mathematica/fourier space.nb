      RowBox[{
       RowBox[{
        RowBox[{"Re", "[", "a", "]"}], ">", "0"}], "&&", 
       RowBox[{
        RowBox[{"Re", "[", "c", "]"}], ">", "0"}], "&&", 
       RowBox[{
        RowBox[{"Re", "[", 
