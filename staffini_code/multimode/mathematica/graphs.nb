Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Kern1D", "[", 
    RowBox[{"x_", ",", "xp_", ",", "\[Xi]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     FractionBox["\[ImaginaryI]", 
      RowBox[{"Pi", "*", 
       RowBox[{"Sin", "[", "\[Xi]", "]"}]}]], "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"-", "\[ImaginaryI]"}], "2"], 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"xp", "^", "2"}], "+", 
          RowBox[{"x", "^", "2"}]}], 
         RowBox[{"Tan", "[", "\[Xi]", "]"}]], "-", 
        FractionBox[
         RowBox[{"2", "*", "xp", "*", "x"}], 
         RowBox[{"Sin", "[", "\[Xi]", "]"}]]}], ")"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Kern", "[", 
    RowBox[{"x_", ",", "xp_", ",", "y_", ",", "yp_", ",", "\[Xi]_"}], "]"}], 
   "=", 
   RowBox[{
    FractionBox["\[ImaginaryI]", 
     RowBox[{"Pi", "*", 
      RowBox[{"Sin", "[", "\[Xi]", "]"}]}]], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"-", "\[ImaginaryI]"}], "2"], 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"xp", "^", "2"}], "+", 
          RowBox[{"x", "^", "2"}]}], 
         RowBox[{"Tan", "[", "\[Xi]", "]"}]], "-", 
        FractionBox[
         RowBox[{"2", "*", "xp", "*", "x"}], 
         RowBox[{"Sin", "[", "\[Xi]", "]"}]], "+", 
        FractionBox[
         RowBox[{
          RowBox[{"yp", "^", "2"}], "+", 
          RowBox[{"y", "^", "2"}]}], 
         RowBox[{"Tan", "[", "\[Xi]", "]"}]], "-", 
        FractionBox[
         RowBox[{"2", "*", "y", "*", "yp"}], 
         RowBox[{"Sin", "[", "\[Xi]", "]"}]]}], ")"}]}], "]"}]}]}], 
  ";"}]}], "Input"],

