Cell[BoxData[
 FractionBox[
  RowBox[{"\[ImaginaryI]", " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["x", "2"], "+", 
       SuperscriptBox["xp", "2"], "+", 
       SuperscriptBox["y", "2"], "+", 
       SuperscriptBox["yp", "2"]}], ")"}], " ", 
     RowBox[{"Cot", "[", "\[Xi]", "]"}]}]], " ", 
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{
       RowBox[{"-", "\[ImaginaryI]"}], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", " ", "xp"}], "+", 
         RowBox[{"y", " ", "yp"}]}], ")"}], " ", 
       RowBox[{"Csc", "[", "\[Xi]", "]"}]}]], "+", 
     SuperscriptBox["\[ExponentialE]", 
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", " ", "xp"}], "+", 
         RowBox[{"y", " ", "yp"}]}], ")"}], " ", 
       RowBox[{"Csc", "[", "\[Xi]", "]"}]}]]}], ")"}], " ", 
   RowBox[{"Csc", "[", "\[Xi]", "]"}]}], 
  RowBox[{"4", " ", "\[Pi]"}]]], "Output",
 CellChangeTimes->{{3.690546001246501*^9, 3.6905460245628023`*^9}, 
