Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Kern1D", "[", 
    RowBox[{"x_", ",", "xp_", ",", "\[Xi]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     FractionBox["\[ImaginaryI]", 
      RowBox[{"2", " ", "Pi", "*", 
       RowBox[{"Sin", "[", "\[Xi]", "]"}]}]], "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"-", "\[ImaginaryI]"}], "2"], 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"xp", "^", "2"}], "+", 
          RowBox[{"x", "^", "2"}]}], 
         RowBox[{"Tan", "[", "\[Xi]", "]"}]], "-", 
        FractionBox[
         RowBox[{"2", "*", "xp", "*", "x"}], 
         RowBox[{"Sin", "[", "\[Xi]", "]"}]]}], ")"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"D1", "[", 
    RowBox[{"x_", ",", "xp_", ",", "y_", ",", "yp_", ",", "\[Xi]_"}], "]"}], 
   "=", 
   RowBox[{
    RowBox[{"Kern1D", "[", 
     RowBox[{"x", ",", "xp", ",", "\[Xi]"}], "]"}], 
    RowBox[{"Kern1D", "[", 
     RowBox[{"y", ",", "yp", ",", "\[Xi]"}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"D2", "[", 
    RowBox[{"x_", ",", "xp_", ",", "y_", ",", "yp_", ",", "\[Xi]_"}], "]"}], 
   "=", 
   RowBox[{
    FractionBox["1", "2"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Kern1D", "[", 
        RowBox[{"x", ",", "xp", ",", "\[Xi]"}], "]"}], 
       RowBox[{"Kern1D", "[", 
        RowBox[{"y", ",", "yp", ",", "\[Xi]"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"Kern1D", "[", 
        RowBox[{
         RowBox[{"-", "x"}], ",", "xp", ",", "\[Xi]"}], "]"}], 
       RowBox[{"Kern1D", "[", 
        RowBox[{
         RowBox[{"-", "y"}], ",", "yp", ",", "\[Xi]"}], "]"}]}]}], ")"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"D3", "[", 
   RowBox[{"x_", ",", "xp_", ",", "y_", ",", "yp_", ",", "\[Xi]_"}], "]"}], 
  "=", 
  RowBox[{
   FractionBox["\[ImaginaryI]", 
    RowBox[{"4", "Pi", " ", 
     RowBox[{"Sin", "[", "\[Xi]", "]"}]}]], 
   RowBox[{"Exp", "[", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["\[ImaginaryI]", "2"]}], " ", 
     FractionBox[
      RowBox[{
       RowBox[{"x", "^", "2"}], "+", 
       RowBox[{"xp", "^", "2"}], "+", 
       RowBox[{"y", "^", "2"}], "+", 
       RowBox[{"yp", "^", "2"}]}], 
      RowBox[{"Tan", "[", "\[Xi]", "]"}]]}], "]"}], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        FractionBox["\[ImaginaryI]", 
         RowBox[{"Sin", "[", "\[Xi]", "]"}]]}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "*", "xp"}], "+", 
         RowBox[{"y", "*", "yp"}]}], ")"}]}], "]"}], "+", 
     RowBox[{"Exp", "[", 
      RowBox[{
       FractionBox["\[ImaginaryI]", 
        RowBox[{"Sin", "[", "\[Xi]", "]"}]], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"x", "*", "xp"}], "+", 
         RowBox[{"y", "*", "yp"}]}], ")"}]}], "]"}]}], ")"}]}]}]}], "Input",
 CellChangeTimes->{
