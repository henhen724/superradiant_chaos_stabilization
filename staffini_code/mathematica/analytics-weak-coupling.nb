Notebook[{

Cell[CellGroupData[{
Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["U", "long"], "(", 
    RowBox[{"r", ",", 
     RowBox[{"r", "'"}], ",", "\[Theta]"}], ")"}], TraditionalForm]],
  FormatType->"TraditionalForm"],
 ", long range part of U(r, r\[CloseCurlyQuote]), analytic form"
}], "Section",
 CellChangeTimes->{{3.7482501601670237`*^9, 3.74825016054842*^9}, {
  3.7482503041371193`*^9, 3.7482503524476748`*^9}, {3.748250389798839*^9, 
  3.748250431477992*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Theta]", "=", 
   RowBox[{"Pi", "/", "4"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]A", "=", 
   RowBox[{"Sqrt", "[", 
    RowBox[{"50", "/", "4"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fP", "=", "1"}], ";"}]}], "Input",
 CellChangeTimes->{{3.7482505439669943`*^9, 3.748250553602853*^9}, 
   3.748250695791471*^9, {3.748251049446602*^9, 3.748251052902186*^9}, {
   3.748251115836935*^9, 3.748251119852408*^9}, {3.748251368142736*^9, 
   3.748251387014402*^9}, 3.74825220455466*^9}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Ulong", "[", 
   RowBox[{"r_", ",", "rp_", ",", "f_"}], "]"}], "=", 
  RowBox[{
   FractionBox[
    RowBox[{"2", " ", 
     SuperscriptBox["f", "2"]}], 
    RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"2", "\[Theta]"}], "]"}], 
     SuperscriptBox[
      RowBox[{"Cos", "[", "\[Theta]", "]"}], "2"]}]], 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"Cos", "[", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"r", "+", "rp"}], ")"}], "2"], 
       RowBox[{"2", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"2", "\[Theta]"}], "]"}]}]], "]"}], "+", 
     RowBox[{"Cos", "[", 
      FractionBox[
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"r", "-", "rp"}], ")"}], "2"], 
       RowBox[{"2", " ", 
        RowBox[{"Sin", "[", 
         RowBox[{"2", "\[Theta]"}], "]"}]}]], "]"}]}], ")"}]}]}]], "Input",
 CellChangeTimes->{{3.748250403951272*^9, 3.74825042174197*^9}, {
  3.748250536547176*^9, 3.7482505994338818`*^9}, {3.7482506849755917`*^9, 
  3.74825077080576*^9}, {3.7482513765107813`*^9, 3.748251383198534*^9}, {
  3.74825254092192*^9, 3.748252546825878*^9}, {3.748259423812497*^9, 
  3.74825942673953*^9}}],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"4", " ", "\[ImaginaryI]", " ", 
    SuperscriptBox["f", "2"], " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Cos", "[", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"r", "-", "rp"}], ")"}], "2"]}], "]"}], "+", 
      RowBox[{"Cos", "[", 
       RowBox[{
        FractionBox["1", "2"], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"r", "+", "rp"}], ")"}], "2"]}], "]"}]}], ")"}]}], 
   "\[Pi]"]}]], "Output",
 CellChangeTimes->{3.748258480652081*^9, 3.748258562092239*^9, 
  3.74825889979058*^9, 3.748259025855281*^9, 3.748259057411181*^9, 
  3.7482594270520277`*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"psi", "[", "rp_", "]"}], "=", 
  RowBox[{
   FractionBox["1", 
    RowBox[{
     RowBox[{"Sqrt", "[", 
      RowBox[{"2", " ", "Pi"}], "]"}], "\[Sigma]A"}]], 
   RowBox[{"Exp", "[", 
    RowBox[{"-", 
     FractionBox[
      SuperscriptBox["rp", "2"], 
      RowBox[{"4", " ", 
       SuperscriptBox["\[Sigma]A", "2"]}]]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.7482509155667267`*^9, 3.7482509248895903`*^9}, {
   3.748250990096114*^9, 3.748251000623732*^9}, {3.748251035526949*^9, 
   3.748251097877664*^9}, {3.74825113969235*^9, 3.748251145900256*^9}, {
   3.748258669679123*^9, 3.748258686154069*^9}, 3.748258717356049*^9, 
   3.748259053928295*^9}],

Cell[BoxData[
 FractionBox[
  SuperscriptBox["\[ExponentialE]", 
   RowBox[{"-", 
    FractionBox[
     SuperscriptBox["rp", "2"], "50"]}]], 
  RowBox[{"5", " ", 
   SqrtBox["\[Pi]"]}]]], "Output",
 CellChangeTimes->{3.748259057434367*^9, 3.748259433347625*^9}]
}, Open  ]],

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"psi", "[", "rp_", "]"}], "=", "1"}], "*)"}]}]], "Input",
 CellChangeTimes->{{3.74825869384277*^9, 3.7482587194901943`*^9}, 
   3.748259049284911*^9}],

Cell[BoxData[" "], "Input",
 CellChangeTimes->{{3.7482586891421957`*^9, 3.748258691883325*^9}}],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{"interaction", "[", 
    RowBox[{"r_", ",", "f_"}], "]"}], "=", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Ulong", "[", 
       RowBox[{"r", ",", "rp", ",", "f"}], "]"}], "*", 
      RowBox[{
       RowBox[{"psi", "[", "rp", "]"}], "^", "2"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"rp", ",", 
       RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
     RowBox[{"Assumptions", "\[Rule]", " ", 
      RowBox[{
       RowBox[{"rp", " \[InvisibleSpace]", "\[Element]", " ", "Reals"}], "&&", 
       RowBox[{"r", "\[Element]", "Reals"}]}]}]}], "]"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.748250871375574*^9, 3.748250905849839*^9}, {
   3.748251217682282*^9, 3.748251256649702*^9}, {3.7482513193042717`*^9, 
   3.748251320664116*^9}, {3.748251351887376*^9, 3.7482513536470337`*^9}, {
