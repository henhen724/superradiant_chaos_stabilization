   3.748259440698503*^9}, 3.748260198243174*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"interaction", "[", 
    RowBox[{"r_", ",", "f_"}], "]"}], "=", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{"4", " ", "\[ImaginaryI]", " ", 
      SqrtBox[
       FractionBox["2", "629"]], " ", 
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{"-", 
           FractionBox["25", "629"]}], "-", 
          FractionBox[
           RowBox[{"2", " ", "\[ImaginaryI]"}], "629"]}], ")"}], " ", 
        SuperscriptBox["r", "2"]}]], " ", 
      RowBox[{"(", 
       RowBox[{
        SqrtBox[
         RowBox[{"2", "-", 
          RowBox[{"25", " ", "\[ImaginaryI]"}]}]], "+", 
        RowBox[{
         SqrtBox[
          RowBox[{"2", "+", 
           RowBox[{"25", " ", "\[ImaginaryI]"}]}]], " ", 
         SuperscriptBox["\[ExponentialE]", 
          FractionBox[
           RowBox[{"4", " ", "\[ImaginaryI]", " ", 
            SuperscriptBox["r", "2"]}], "629"]]}]}], ")"}], " ", 
      SuperscriptBox["f", "2"]}], 
     RowBox[{"5", " ", 
      SuperscriptBox["\[Pi]", 
       RowBox[{"3", "/", "2"}]]}]]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.748260176179139*^9, 3.7482602046191883`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"flatinteraction", "[", 
   RowBox[{"r_", ",", "f_"}], "]"}], "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"Ulong", "[", 
     RowBox[{"r", ",", "rp", ",", "f"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"rp", ",", 
      RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{
      RowBox[{"r", "\[Element]", "Reals"}], "&&", 
      RowBox[{"rp", "\[Element]", "Reals"}]}]}]}], "]"}]}]], "Input",
