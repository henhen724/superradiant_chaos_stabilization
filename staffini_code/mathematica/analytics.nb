Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pumpdisc", "[", "x_", "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"pump", "[", 
       RowBox[{"xp", ",", "x"}], "]"}], "*", 
      RowBox[{"Kern1D", "[", 
       RowBox[{"x", ",", "xp", ",", 
        RowBox[{"Pi", "/", "4"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"xp", ",", 
       RowBox[{"-", "32"}], ",", "32", ",", "L"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"disc", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"Abs", "[", 
        RowBox[{"pumpdisc", "[", "x", "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
