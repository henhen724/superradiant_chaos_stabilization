         RowBox[{"x", ",", 
          RowBox[{"-", "20"}], ",", "20"}], "}"}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "400"}], ",", 
        RowBox[{
        "PlotLabel", "\[Rule]", "\"\<D(x,0,Pi/4) without cutoff\>\""}]}], 
       "]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Re", "[", 
