Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Want", " ", "the", " ", "value", " ", "at", " ", 
    RowBox[{"(", "one", ")"}], " ", "peak", " ", "so", " ", "I", " ", "can", 
    " ", "put", " ", "a", " ", "line", " ", "on", " ", "it", " ", 
    RowBox[{"(", 
     RowBox[{
     "because", " ", "I", " ", "liked", " ", "it", " ", "but", " ", "only", 
      " ", "so", " ", "so"}], ")"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"maxcont", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{"N", "[", 
       RowBox[{"X\[Alpha]cont", "[", 
        RowBox[{"-", "shiftalpha"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"maxdisc", "=", 
     RowBox[{"Abs", "[", 
      RowBox[{"N", "[", 
       RowBox[{"X\[Alpha]disc", "[", 
        RowBox[{"-", "shiftalpha"}], "]"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{"maxcont", "/", "maxdisc"}], "\[IndentingNewLine]", 
   RowBox[{"thisshouldbe1", "=", 
    RowBox[{"maxdisc", "/", "maxcont"}]}], "\[IndentingNewLine]", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Plotting", " ", "the", " ", "value", " ", "of", " ", "the", " ", 
     "continuous", " ", 
     RowBox[{"distribution", "/", "discrete"}], " ", "distribution", " ", 
     "at", " ", "lattice", " ", "points"}], " ", "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{"DiscretePlot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Abs", "[", 
