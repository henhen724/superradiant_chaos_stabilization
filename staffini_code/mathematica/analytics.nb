        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<\[Times]\>\"", ",", "Red"}], "]"}], ",", "Medium"}], 
        "}"}]}], ",", 
      RowBox[{"PlotLegends", "\[Rule]", 
       RowBox[{"Placed", "[", 
        RowBox[{
         RowBox[{"{", "\"\<X*\[Alpha] sampled discretely\>\"", "}"}], ",", 
