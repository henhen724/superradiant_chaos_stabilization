Cell[CellGroupData[{

Cell["Smoothing fn stuff", "Section",
 CellChangeTimes->{{3.682145280505501*^9, 3.6821452882636757`*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"fp", "=", "10"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]", "=", "20"}], ";"}]}], "Input",
 CellChangeTimes->{{3.682146133587696*^9, 3.6821461397856073`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"SmoothingFn", "[", 
    RowBox[{
    "x_", ",", "y_", ",", "xp_", ",", "yp_", ",", "L_", ",", "power_"}], 
    "]"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", " ", "Pi", " ", 
      RowBox[{"L", "^", "2"}]}]], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"x", "-", "y"}], ")"}], "^", "power"}], 
        RowBox[{"2", 
         RowBox[{"L", "^", "2"}]}]]}], "-", 
      FractionBox[
       RowBox[{
        RowBox[{"(", 
         RowBox[{"xp", "-", "yp"}], ")"}], "^", "power"}], 
       RowBox[{"2", 
        RowBox[{"L", "^", "2"}]}]]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{3.682145690829212*^9}],

