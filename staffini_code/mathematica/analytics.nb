Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
  "Coefficients", " ", "gotten", " ", "by", " ", "pen", " ", "and", " ", 
   "paper"}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.68214572067222*^9, 3.682145730180121*^9}}],

Cell[BoxData[{
 RowBox[{"Clear", "[", "L", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Alpha]", "[", 
    RowBox[{"\[Xi]_", ",", "L_"}], "]"}], "=", 
   RowBox[{
    FractionBox["\[ImaginaryI]", 
     RowBox[{"2", " ", 
      RowBox[{"Tan", "[", "\[Xi]", "]"}]}]], "+", 
    FractionBox["1", 
     RowBox[{"2", 
      RowBox[{"L", "^", "2"}]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Beta]", "[", 
    RowBox[{"\[Xi]_", ",", "L_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"\[Alpha]", "[", 
     RowBox[{"\[Xi]", ",", "L"}], "]"}], "+", 
    FractionBox["1", 
     RowBox[{"4", "*", 
      RowBox[{"\[Alpha]", "[", 
       RowBox[{"\[Xi]", ",", "L"}], "]"}], "*", 
      RowBox[{
       RowBox[{"Sin", "[", "\[Xi]", "]"}], "^", "2", " "}]}]]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"A", "[", 
    RowBox[{"\[Xi]_", ",", "L_"}], "]"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", "Pi", " ", 
      SuperscriptBox["L", "2"]}]], "*", 
    RowBox[{"Sqrt", "[", 
     FractionBox[
      RowBox[{"\[ImaginaryI]", "*", "Pi"}], 
      RowBox[{
       RowBox[{"\[Beta]", "[", 
        RowBox[{"\[Xi]", ",", "L"}], "]"}], "*", 
       RowBox[{"\[Alpha]", "[", 
        RowBox[{"\[Xi]", ",", "L"}], "]"}], "*", 
       RowBox[{"Sin", "[", "\[Xi]", "]"}]}]], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"B", "[", 
    RowBox[{"\[Xi]_", ",", "L_"}], "]"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", 
      RowBox[{"L", "^", "2"}]}]], "-", 
    FractionBox["1", 
     RowBox[{"4", 
      RowBox[{"L", "^", "4"}], "*", 
      RowBox[{"\[Beta]", "[", 
       RowBox[{"\[Xi]", ",", "L"}], "]"}]}]]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Cc", "[", 
    RowBox[{"\[Xi]_", ",", "L_"}], "]"}], "=", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " "}], 
    RowBox[{"4", "*", 
     RowBox[{"L", "^", "4"}], "*", 
     RowBox[{"\[Alpha]", "[", 
      RowBox[{"\[Xi]", ",", "L"}], "]"}], "*", 
     RowBox[{"\[Beta]", "[", 
      RowBox[{"\[Xi]", ",", "L"}], "]"}], "*", 
     RowBox[{"Sin", "[", "\[Xi]", "]"}]}]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"S", "[", 
    RowBox[{"x_", ",", "xp_", ",", "\[Xi]_", ",", "L_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"A", "[", 
     RowBox[{"\[Xi]", ",", "L"}], "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"B", "[", 
         RowBox[{"\[Xi]", ",", "L"}], "]"}]}], "*", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["x", "2"], "+", 
         SuperscriptBox["xp", "2"]}], ")"}]}], "-", 
      RowBox[{
       RowBox[{"Cc", "[", 
        RowBox[{"\[Xi]", ",", "L"}], "]"}], "*", "x", "*", "xp"}]}], 
     "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.6785152184478083`*^9, 3.6785152203332443`*^9}, {
   3.678522258865361*^9, 3.678522261752836*^9}, {3.678611793644041*^9, 
   3.6786118012750463`*^9}, {3.678614622707883*^9, 3.678614792167448*^9}, {
