      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"Psi", "[", 
         RowBox[{"xpp", ",", "\[Sigma]P"}], "]"}], "]"}], "^", "2"}], "*", 
      RowBox[{"SEven", "[", 
       RowBox[{"xpp", ",", "xp", ",", "0", ",", "0", ",", 
        RowBox[{
         RowBox[{"-", "Pi"}], "/", "4"}], ",", "\[Gamma]P", ",", 
        RowBox[{"L", "/", "2"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"xpp", ",", 
       RowBox[{"-", "ls"}], ",", "ls", ",", "L"}], "}"}]}], "]"}]}], 
