         RowBox[{"x", ",", 
          RowBox[{"-", "20"}], ",", "20"}], "}"}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "400"}], ",", 
        RowBox[{
        "PlotLabel", "\[Rule]", 
         "\"\<\!\(\*SubscriptBox[\(D\), \
\(cutoff\)]\)(x,0,\[Pi]/4,1/50)\>\""}]}], "]"}], "}"}], ",", 
     RowBox[{"{", 
