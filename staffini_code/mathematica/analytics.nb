         RowBox[{"N", "[", 
          RowBox[{"X\[Alpha]cont", "[", "q", "]"}], "]"}], "]"}]}], ")"}], 
      "^", 
      RowBox[{"-", "1"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"q", ",", 
       RowBox[{"-", "ls"}], ",", "ls", ",", "L"}], "}"}], ",", 
