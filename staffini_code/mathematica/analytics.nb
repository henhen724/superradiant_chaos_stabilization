Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
  "Trying", " ", "to", " ", "check", " ", "the", " ", "magnitude", " ", 
   "that", " ", "mod", " ", "sq", " ", "alpha", " ", "should", " ", "output", 
   " ", "first", " ", "few", " ", "steps"}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.722163066805839*^9, 3.722163068909273*^9}, {
  3.724760689480667*^9, 3.724760721047353*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"alp", "[", 
    RowBox[{
    "x_", ",", "fP_", ",", "\[Sigma]_", ",", "Delta0_", ",", "kappa_"}], 
    "]"}], "=", 
   RowBox[{
    RowBox[{"Abs", "[", 
     RowBox[{
      RowBox[{"-", "\[ImaginaryI]"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"Delta0", "-", 
           RowBox[{"\[ImaginaryI]", " ", "kappa"}]}], ")"}], 
         RowBox[{"Alpha", "[", 
          RowBox[{"x", ",", "0", ",", "\[Sigma]", ",", "fP"}], "]"}]}], "+", 
        RowBox[{"Alpha", "[", 
         RowBox[{"x", ",", "0", ",", "\[Sigma]", ",", "fP"}], "]"}]}], 
       ")"}]}], "]"}], "^", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Alpha", "[", 
     RowBox[{"x", ",", "0", ",", "2", ",", "1"}], "]"}], "^", "2"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "12"}], ",", "12"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"alp", "[", 
    RowBox[{"x", ",", "1", ",", "2", ",", "1", ",", "10"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "12"}], ",", "12"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.719581535259707*^9, 3.719581535655469*^9}, {
   3.724759617535048*^9, 3.7247596514623213`*^9}, {3.724759701885248*^9, 
   3.724759839569607*^9}, {3.724759896903893*^9, 3.7247599053196993`*^9}, 
