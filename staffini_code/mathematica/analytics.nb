 RowBox[{
  RowBox[{
   RowBox[{"XEvenSmoothdisc", "[", 
    RowBox[{"x_", ",", "xp_"}], "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"L", "*", 
      RowBox[{"SEven", "[", 
       RowBox[{"x", ",", "xpp", ",", "0", ",", "0", ",", 
