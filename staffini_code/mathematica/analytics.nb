Cell[BoxData[{
 RowBox[{
  RowBox[{"points", "=", "64"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ls", "=", "12"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"L", "=", 
   RowBox[{"ls", "*", 
    RowBox[{"2", "/", 
     RowBox[{"(", 
      RowBox[{"points", "+", "1"}], ")"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"XEvendisc", "[", 
    RowBox[{"x_", ",", "xp_"}], "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"L", "*", 
      RowBox[{"KernEven", "[", 
       RowBox[{"x", ",", "xpp", ",", "0", ",", "0", ",", 
        RowBox[{"Pi", "/", "4"}], ",", "\[Gamma]P"}], "]"}], "*", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"Psi", "[", 
         RowBox[{"xpp", ",", "\[Sigma]P"}], "]"}], "]"}], "^", "2"}], "*", 
      RowBox[{"KernEven", "[", 
       RowBox[{"xpp", ",", "xp", ",", "0", ",", "0", ",", 
        RowBox[{
         RowBox[{"-", "Pi"}], "/", "4"}], ",", "\[Gamma]P"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"xpp", ",", 
       RowBox[{"-", "ls"}], ",", "ls", ",", "L"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"XEvendisctable", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"Re", "[", 
        RowBox[{"XEvendisc", "[", 
         RowBox[{"x", ",", "0"}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "ls"}], ",", "ls", ",", "L"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
