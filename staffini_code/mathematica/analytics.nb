Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
  "Comparing", " ", "results", " ", "after", " ", "convolving", " ", "only", 
   " ", "one", " ", "side", " ", "of", " ", "D", "*", "f", " ", "with", " ", 
   "S"}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.682146036680644*^9, 3.682146051883451*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"smoothpump", "[", 
    RowBox[{"y_", ",", "yp_", ",", "L_"}], "]"}], "=", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"pump", "[", 
       RowBox[{"x", ",", "xp"}], "]"}], "*", 
      RowBox[{"SmoothingFn", "[", 
       RowBox[{"x", ",", "y", ",", "xp", ",", "yp", ",", "L", ",", "2"}], 
       "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "100"}], ",", "100"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"xp", ",", 
       RowBox[{"-", "100"}], ",", "100"}], "}"}]}], "]"}]}], ";"}]], "Input"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
