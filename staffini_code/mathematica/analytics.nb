Cell["Integratin stuff", "Section",
 CellChangeTimes->{{3.720953695165584*^9, 3.720953699138331*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"phiarg", "[", 
    RowBox[{"x_", ",", "xp_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"Exp", "[", 
     FractionBox[
      RowBox[{"-", 
       RowBox[{"xp", "^", "2"}]}], 
      RowBox[{"2", " ", 
       RowBox[{"\[Sigma]", "^", "2"}]}]], "]"}], "*", 
    FractionBox["1", 
     RowBox[{"Sqrt", "[", 
      RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", 
       RowBox[{"Sin", "[", "\[Xi]", "]"}]}], "]"}]], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      FractionBox["\[ImaginaryI]", "2"], 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"x", "^", "2"}], "+", 
          RowBox[{"xp", "^", "2"}]}], 
         RowBox[{"Tan", "[", "\[Xi]", "]"}]], "-", 
        FractionBox[
         RowBox[{"2", " ", "x", " ", "xp"}], 
         RowBox[{"Sin", "[", "\[Xi]", "]"}]]}], ")"}]}], "]"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.72095370295326*^9, 3.7209537862512693`*^9}, {
  3.720953819450067*^9, 3.7209538989399023`*^9}, {3.720954093154479*^9, 
  3.720954126433797*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"int", "=", 
   RowBox[{"Integrate", "[", " ", 
    RowBox[{
     RowBox[{"AA", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "a"}], " ", 
         RowBox[{"x", "^", "2"}]}], "+", 
        RowBox[{"b", " ", "x"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{
       RowBox[{
        RowBox[{"Re", "[", "a", "]"}], ">", "0"}], "&&", 
       RowBox[{
        RowBox[{"Re", "[", "c", "]"}], ">", "0"}], "&&", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "4"}], " ", "c"}], "+", 
          FractionBox[
           SuperscriptBox["e", "2"], "a"]}], "]"}], "<", "0"}]}]}]}], "]"}]}],
   ";"}]], "Input",
 CellChangeTimes->{{3.720954053507935*^9, 3.7209540584356537`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"replacements", "[", "x_", "]"}], "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"AA", "\[Rule]", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"Sqrt", "[", 
        RowBox[{"\[ImaginaryI]", " ", "\[Pi]", " ", 
         RowBox[{"Sin", "[", "\[Xi]", "]"}]}], "]"}]], "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        FractionBox["\[ImaginaryI]", "2"], 
        FractionBox[
         RowBox[{"x", "^", "2"}], 
         RowBox[{"Tan", "[", "\[Xi]", "]"}]]}], "]"}]}]}], " ", ",", 
    RowBox[{"a", "\[Rule]", 
     RowBox[{"(", 
      RowBox[{
       FractionBox["1", 
        RowBox[{"2", 
         RowBox[{"\[Sigma]", "^", "2"}]}]], "-", 
       FractionBox["\[ImaginaryI]", 
        RowBox[{"2", 
         RowBox[{"Tan", "[", "\[Xi]", "]"}]}]]}], ")"}]}], ",", 
    RowBox[{"b", "\[Rule]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["\[ImaginaryI]", 
        RowBox[{"Sin", "[", "\[Xi]", "]"}]]}], "x"}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.699788519469356*^9, 3.699788649704708*^9}, {
