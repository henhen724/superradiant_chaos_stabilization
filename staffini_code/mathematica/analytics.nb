Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"int", "[", "x_", "]"}], "=", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"pump", "[", 
       RowBox[{"0", ",", "xp"}], "]"}], "*", 
      RowBox[{"Kern1D", "[", 
       RowBox[{"x", ",", "xp", ",", 
        RowBox[{"Pi", "/", "4"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"xp", ",", 
       RowBox[{"-", "100"}], ",", "100"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"intsmooth", "[", "x_", "]"}], "=", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"pump", "[", 
       RowBox[{"0", ",", "xp"}], "]"}], "*", 
      RowBox[{"S", "[", 
       RowBox[{"x", ",", "xp", ",", 
        RowBox[{"Pi", "/", "4"}], ",", "4"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"xp", ",", 
       RowBox[{"-", "100"}], ",", "100"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"intsmoothan", "[", "x_", "]"}], "=", 
   RowBox[{"Integrate", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"pump", "[", 
       RowBox[{"0", ",", "xp"}], "]"}], "*", 
      RowBox[{"Evaluate", "[", 
       RowBox[{"SimplifiedResult", "[", 
        RowBox[{"x", ",", "xp", ",", 
         RowBox[{"Pi", "/", "4"}], ",", "4"}], "]"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"xp", ",", 
       RowBox[{"-", "100"}], ",", "100"}], "}"}]}], "]"}]}], ";"}]}], "Input"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Abs", "[", 
      RowBox[{"int", "[", "x", "]"}], "]"}], ",", 
     RowBox[{"Abs", "[", 
      RowBox[{"intsmooth", "[", "x", "]"}], "]"}], ",", 
     RowBox[{"Abs", "[", 
      RowBox[{"intsmoothan", "[", "x", "]"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "32"}], ",", "32"}], "}"}], ",", 
   RowBox[{"PlotLegends", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
     "\"\<Kern\>\"", ",", "\"\<Smooth\>\"", ",", 
      "\"\<Smooth Mathematica\>\""}], "}"}]}], ",", 
   RowBox[{"PlotStyle", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"Normal", ",", 
      RowBox[{"{", 
       RowBox[{"Thick", ",", "Red"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Dotted", ",", "Yellow"}], "}"}]}], "}"}]}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Abs", "[", 
    RowBox[{"intsmooth", "[", "x", "]"}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "32"}], ",", "32"}], "}"}]}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
