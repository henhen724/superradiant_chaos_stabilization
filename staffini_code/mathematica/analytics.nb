Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"X", "[", 
   RowBox[{"x_", ",", "xpp_", ",", "\[Sigma]_"}], "]"}], "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Dkern", "[", 
      RowBox[{"x", ",", "xp", ",", "0", ",", "0", ",", 
       RowBox[{"Pi", "/", "4"}], ",", "0"}], "]"}], "*", 
     RowBox[{"Dkern", "[", 
      RowBox[{"xp", ",", "xpp", ",", "0", ",", "0", ",", 
       RowBox[{"Pi", "/", "4"}], ",", "0"}], "]"}], "*", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"Psi", "[", 
        RowBox[{"xp", ",", "0", ",", "\[Sigma]"}], "]"}], "]"}], "^", "2"}]}],
     ",", 
    RowBox[{"{", 
     RowBox[{"xp", ",", 
      RowBox[{"-", "\[Infinity]"}], ",", " ", "\[Infinity]"}], "}"}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{
      RowBox[{"\[Sigma]", "\[Element]", "Integers"}], "&&", 
      RowBox[{"\[Sigma]", ">", "0"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.7195811080778418`*^9, 3.7195812166475277`*^9}, {
   3.719581340749395*^9, 3.719581348404539*^9}, {3.719581388708335*^9, 
   3.719581390403948*^9}, 3.719581709612129*^9, 3.719581744252097*^9, {
   3.719582087162764*^9, 3.719582101033431*^9}, {3.71958220953889*^9, 
   3.719582209718183*^9}, {3.719582241861616*^9, 3.719582242317401*^9}, {
   3.719582298340419*^9, 3.719582300659897*^9}, {3.7195823502664137`*^9, 
   3.719582361121708*^9}, {3.719582950072136*^9, 3.719582956303485*^9}, {
   3.719654988720245*^9, 3.719655006671372*^9}}],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["x", "2"], "+", 
         SuperscriptBox["xpp", "2"]}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", "+", 
         RowBox[{"2", " ", "\[ImaginaryI]", " ", 
          SuperscriptBox["\[Sigma]", "2"]}]}], ")"}]}], 
      RowBox[{
       RowBox[{"2", " ", "\[ImaginaryI]"}], "+", 
       RowBox[{"4", " ", 
        SuperscriptBox["\[Sigma]", "2"]}]}]]}]], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", "0.04042130405524658`"}], " ", 
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "-", "xpp"}], ")"}], "2"], " ", 
         SuperscriptBox["\[Sigma]", "2"]}], 
        RowBox[{"\[ImaginaryI]", "+", 
         RowBox[{"2", " ", 
          SuperscriptBox["\[Sigma]", "2"]}]}]]]}], "-", 
     RowBox[{"0.04042130405524658`", " ", 
      SuperscriptBox["\[ExponentialE]", 
       FractionBox[
        RowBox[{"\[ImaginaryI]", " ", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"x", "+", "xpp"}], ")"}], "2"], " ", 
         SuperscriptBox["\[Sigma]", "2"]}], 
        RowBox[{"\[ImaginaryI]", "+", 
         RowBox[{"2", " ", 
          SuperscriptBox["\[Sigma]", "2"]}]}]]]}]}], ")"}]}], 
  RowBox[{"\[Sigma]", " ", 
   SqrtBox[
    RowBox[{"1", "-", 
     RowBox[{"2", " ", "\[ImaginaryI]", " ", 
      SuperscriptBox["\[Sigma]", "2"]}]}]]}]]], "Output",
 CellChangeTimes->{
  3.719581225340114*^9, {3.719581385079999*^9, 3.719581405311647*^9}, 
