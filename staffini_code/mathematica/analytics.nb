Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"Then", " ", "for", " ", "the", " ", "right", " ", "parity", " ", 
    RowBox[{"kernel", ":"}]}], " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SEven", "[", 
     RowBox[{
     "x_", ",", "xp_", ",", "y_", ",", "yp_", ",", "\[Xi]_", ",", "\[Gamma]_",
       ",", "L_"}], "]"}], "=", 
    RowBox[{"0.5", "*", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"S", "[", 
         RowBox[{"x", ",", "xp", ",", 
          RowBox[{"\[Xi]", "+", 
           RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}]}], ",", "L"}], "]"}], 
        "*", 
        RowBox[{"S", "[", 
         RowBox[{"y", ",", "yp", ",", 
          RowBox[{"\[Xi]", "+", 
           RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}]}], ",", "L"}], "]"}]}], 
       "+", 
       RowBox[{
        RowBox[{"S", "[", 
         RowBox[{"x", ",", 
          RowBox[{"-", "xp"}], ",", 
          RowBox[{"\[Xi]", "+", 
           RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}]}], ",", "L"}], "]"}], 
        "*", 
        RowBox[{"S", "[", 
         RowBox[{"y", ",", 
          RowBox[{"-", "yp"}], ",", 
          RowBox[{"\[Xi]", "+", 
           RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}]}], ",", "L"}], 
         "]"}]}]}], ")"}]}]}], ";"}]}]], "Input",
