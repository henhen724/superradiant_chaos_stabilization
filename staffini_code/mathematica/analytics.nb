Cell[BoxData[
 FractionBox[
  RowBox[{
   SqrtBox["2"], " ", 
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", "2"]}], " ", 
     RowBox[{"(", 
      RowBox[{"x", "-", "xp"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"(", 
         RowBox[{"x", "+", "xp"}], ")"}], " ", 
        RowBox[{"Cot", "[", "\[Theta]", "]"}]}], "+", 
       RowBox[{
        RowBox[{"Csc", "[", "\[Theta]", "]"}], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "4"}], " ", "\[ImaginaryI]"}], "+", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "-", "xp"}], ")"}], " ", 
           SuperscriptBox["\[Sigma]", "2"], " ", 
           RowBox[{"Csc", "[", "\[Theta]", "]"}]}]}], ")"}]}]}], ")"}]}]], 
   " ", 
   SqrtBox[
    SuperscriptBox[
     RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"]]}], "\[Pi]"]], "Output",
