Cell[CellGroupData[{

Cell["Getting some sense of how D(x,x\[CloseCurlyQuote],\[Xi]) and D(x,x\
\[CloseCurlyQuote],-\[Xi]) compare", "Section",
 CellChangeTimes->{{3.716115692671783*^9, 3.716115702127082*^9}, {
  3.716639991201689*^9, 3.716640028719325*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"KernCutoff", "[", 
    RowBox[{"x_", ",", "xp_", ",", "\[Xi]_", ",", "\[Gamma]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     FractionBox["\[ImaginaryI]", 
      RowBox[{"2", "*", "Pi", "*", 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Xi]", "+", 
         RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}]}], "]"}]}]], "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"-", "\[ImaginaryI]"}], "2"], 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"xp", "^", "2"}], "+", 
          RowBox[{"x", "^", "2"}]}], 
         RowBox[{"Tan", "[", 
          RowBox[{"\[Xi]", "+", 
           RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}]}], "]"}]], "-", 
        FractionBox[
         RowBox[{"2", "*", "xp", "*", "x"}], 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Xi]", "+", 
           RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}]}], "]"}]]}], ")"}]}], 
     "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{
  3.70342686395288*^9, {3.708774678765669*^9, 3.70877467925346*^9}, {
   3.709018574147339*^9, 3.7090185750272627`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"KernEven", "[", 
    RowBox[{
    "x_", ",", "xp_", ",", "y_", ",", "yp_", ",", "\[Xi]_", ",", 
     "\[Gamma]_"}], "]"}], "=", 
   RowBox[{"0.5", "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"KernCutoff", "[", 
        RowBox[{"x", ",", "xp", ",", "\[Xi]", ",", "\[Gamma]"}], "]"}], "*", 
       RowBox[{"KernCutoff", "[", 
        RowBox[{"y", ",", "yp", ",", "\[Xi]", ",", "\[Gamma]"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"KernCutoff", "[", 
        RowBox[{"x", ",", 
         RowBox[{"-", "xp"}], ",", "\[Xi]", ",", "\[Gamma]"}], "]"}], "*", 
       RowBox[{"KernCutoff", "[", 
        RowBox[{"y", ",", 
         RowBox[{"-", "yp"}], ",", "\[Xi]", ",", "\[Gamma]"}], "]"}]}]}], 
     ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{3.703426867208391*^9}],

