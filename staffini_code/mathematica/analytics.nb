Cell[CellGroupData[{

Cell["\<\
Integrating light field EoM analytically in k-space to figure out what is \
happening to data\
\>", "Section",
 CellChangeTimes->{{3.699786580630742*^9, 3.699786608141514*^9}}],

Cell[BoxData[{
 RowBox[{
  RowBox[{"int1", "=", 
   RowBox[{"Integrate", "[", " ", 
    RowBox[{
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "a"}], " ", 
        RowBox[{"x", "^", "2"}]}], "+", 
       RowBox[{"b", " ", "x"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{
       RowBox[{
        RowBox[{"Re", "[", "a", "]"}], ">", "0"}], "&&", 
       RowBox[{
        RowBox[{"Re", "[", "c", "]"}], ">", "0"}], "&&", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "4"}], " ", "c"}], "+", 
          FractionBox[
           SuperscriptBox["e", "2"], "a"]}], "]"}], "<", "0"}]}]}]}], "]"}]}],
   ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"int2", "=", 
   RowBox[{"Integrate", "[", " ", 
    RowBox[{
     RowBox[{"AA", "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"-", "a"}], " ", 
         RowBox[{"x", "^", "2"}]}], "+", 
        RowBox[{"b", " ", "x"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
     RowBox[{"Assumptions", "\[Rule]", 
      RowBox[{
       RowBox[{
        RowBox[{"Re", "[", "a", "]"}], ">", "0"}], "&&", 
       RowBox[{
        RowBox[{"Re", "[", "c", "]"}], ">", "0"}], "&&", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"-", "4"}], " ", "c"}], "+", 
          FractionBox[
           SuperscriptBox["e", "2"], "a"]}], "]"}], "<", "0"}]}]}]}], "]"}]}],
   ";"}]}], "Input",
