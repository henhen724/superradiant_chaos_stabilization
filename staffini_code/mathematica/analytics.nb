Cell[CellGroupData[{

Cell["Analytic integral for smoothing fn", "Section",
 CellChangeTimes->{{3.682145349574078*^9, 3.68214535276687*^9}, {
  3.708773182548973*^9, 3.708773208677164*^9}}],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
  "Doing", " ", "the", " ", "integral", " ", "with", " ", "arbitrary", " ", 
   "coefficients", " ", "obeying", " ", "the", " ", "conditional", " ", 
   "expr"}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.682145438307787*^9, 3.682145459875908*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"res", "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{"AA", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "a"}], " ", 
        RowBox[{"x", "^", "2"}]}], "+", 
       RowBox[{"b", " ", "x"}], "-", 
       RowBox[{"c", " ", 
        RowBox[{"xp", "^", "2"}]}], "+", 
       RowBox[{"d", " ", "xp"}], "+", 
       RowBox[{"e", " ", "x", " ", "xp"}], "+", "f"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"xp", ",", 
      RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{
      RowBox[{
       RowBox[{"Re", "[", "a", "]"}], ">", "0"}], "&&", 
      RowBox[{
       RowBox[{"Re", "[", "c", "]"}], ">", "0"}], "&&", 
      RowBox[{
       RowBox[{"Re", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"-", "4"}], " ", "c"}], "+", 
         FractionBox[
          SuperscriptBox["e", "2"], "a"]}], "]"}], "<", "0"}]}]}]}], 
   "]"}]}]], "Input",
 CellChangeTimes->{{3.679385663748811*^9, 3.6793856641323967`*^9}, {
  3.67938576620157*^9, 3.67938581001117*^9}, {3.67938586621594*^9, 
  3.6793858691691236`*^9}, {3.679385926342791*^9, 3.679385976787814*^9}, {
  3.6793864452072573`*^9, 3.679386445927082*^9}}],

Cell[BoxData[
 FractionBox[
  RowBox[{"AA", " ", 
   SuperscriptBox["\[ExponentialE]", 
    FractionBox[
     RowBox[{
      SuperscriptBox["d", "2"], "+", 
      RowBox[{"2", " ", "d", " ", "e", " ", "x"}], "+", 
      RowBox[{
       SuperscriptBox["e", "2"], " ", 
       SuperscriptBox["x", "2"]}], "+", 
      RowBox[{"4", " ", "c", " ", 
       RowBox[{"(", 
        RowBox[{"f", "+", 
         RowBox[{"x", " ", 
          RowBox[{"(", 
           RowBox[{"b", "-", 
            RowBox[{"a", " ", "x"}]}], ")"}]}]}], ")"}]}]}], 
     RowBox[{"4", " ", "c"}]]], " ", 
   SqrtBox["\[Pi]"]}], 
  SqrtBox["c"]]], "Output",
 CellChangeTimes->{
  3.679385780743374*^9, 3.679385831280555*^9, 3.679385883605483*^9, {
   3.679385947326736*^9, 3.679385980472032*^9}, 3.679386447922553*^9, 
   3.6814617076631193`*^9, 3.68206961905121*^9, 3.6821454646406803`*^9}]
}, Open  ]],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
  "Replacing", " ", "coefficients", " ", "with", " ", "proper", " ", 
   "factors"}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.682145470260294*^9, 3.682145479729903*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"replacements", "[", 
   RowBox[{"\[Xi]_", ",", "l_"}], "]"}], "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"AA", "\[Rule]", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"2", " ", "Pi", " ", 
        RowBox[{"l", "^", "2"}]}]], " ", 
      RowBox[{"Sqrt", "[", 
       FractionBox["\[ImaginaryI]", 
        RowBox[{"Pi", " ", 
         RowBox[{"Sin", "[", "\[Xi]", "]"}]}]], "]"}]}]}], ",", 
    RowBox[{"a", "\[Rule]", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"2", " ", 
          RowBox[{"l", "^", "2"}]}]], "+", 
        FractionBox["\[ImaginaryI]", 
         RowBox[{"2", " ", 
          RowBox[{"Tan", "[", "\[Xi]", "]"}]}]]}], ")"}]}]}], ",", 
    RowBox[{"b", "\[Rule]", 
     FractionBox["y", 
      RowBox[{"l", "^", "2"}]]}], ",", 
    RowBox[{"c", "\[Rule]", 
     RowBox[{"-", 
      RowBox[{"(", 
       RowBox[{
        FractionBox["1", 
         RowBox[{"2", " ", 
          RowBox[{"l", "^", "2"}]}]], "+", 
        FractionBox["\[ImaginaryI]", 
         RowBox[{"2", " ", 
          RowBox[{"Tan", "[", "\[Xi]", "]"}]}]]}], ")"}]}]}], ",", 
    RowBox[{"d", "\[Rule]", 
     FractionBox["yp", 
      RowBox[{"l", "^", "2"}]]}], ",", 
    RowBox[{"e", "\[Rule]", 
     FractionBox["\[ImaginaryI]", 
      RowBox[{"Sin", "[", "\[Xi]", "]"}]]}], ",", 
    RowBox[{"f", "\[Rule]", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"y", "^", "2"}], "+", 
         RowBox[{"yp", "^", "2"}]}], ")"}]}], "/", 
      RowBox[{"(", 
       RowBox[{"2", " ", 
        RowBox[{"l", "^", "2"}]}], ")"}]}]}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.679029468340602*^9, 3.679029559232998*^9}, {
   3.679029783994632*^9, 3.6790298088891287`*^9}, 3.679031062026924*^9, {
   3.6790317225255404`*^9, 3.6790317397409763`*^9}, {3.679040750629764*^9, 
   3.6790407556618013`*^9}, {3.679041176171979*^9, 3.679041177586711*^9}, 
   3.6790414582268057`*^9, {3.679041524673593*^9, 3.679041527544778*^9}, {
   3.6790418015786047`*^9, 3.679041878638989*^9}, {3.679042287205206*^9, 
   3.679042320708226*^9}, {3.679043462797378*^9, 3.6790434646453247`*^9}, {
   3.682145592871704*^9, 3.682145593848051*^9}}],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"AA", "\[Rule]", 
    FractionBox[
     SqrtBox[
      RowBox[{"\[ImaginaryI]", " ", 
       RowBox[{"Csc", "[", "\[Xi]", "]"}]}]], 
     RowBox[{"2", " ", 
      SuperscriptBox["l", "2"], " ", 
      SuperscriptBox["\[Pi]", 
       RowBox[{"3", "/", "2"}]]}]]}], ",", 
   RowBox[{"a", "\[Rule]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"2", " ", 
        SuperscriptBox["l", "2"]}]]}], "-", 
     RowBox[{
      FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
      RowBox[{"Cot", "[", "\[Xi]", "]"}]}]}]}], ",", 
   RowBox[{"b", "\[Rule]", 
    FractionBox["y", 
     SuperscriptBox["l", "2"]]}], ",", 
   RowBox[{"c", "\[Rule]", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["1", 
       RowBox[{"2", " ", 
        SuperscriptBox["l", "2"]}]]}], "-", 
     RowBox[{
      FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", 
      RowBox[{"Cot", "[", "\[Xi]", "]"}]}]}]}], ",", 
   RowBox[{"d", "\[Rule]", 
    FractionBox["yp", 
     SuperscriptBox["l", "2"]]}], ",", 
   RowBox[{"e", "\[Rule]", 
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"Csc", "[", "\[Xi]", "]"}]}]}], ",", 
   RowBox[{"f", "\[Rule]", 
    FractionBox[
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["y", "2"]}], "-", 
      SuperscriptBox["yp", "2"]}], 
     RowBox[{"2", " ", 
      SuperscriptBox["l", "2"]}]]}]}], "}"}]], "Output",
 CellChangeTimes->{
  3.679029582106037*^9, 3.679029809444929*^9, 3.6790301262682877`*^9, 
   3.679030589697275*^9, {3.679031062677456*^9, 3.679031092155467*^9}, 
   3.679031544678193*^9, 3.6790317689363117`*^9, 3.679040759069466*^9, 
   3.67904117877325*^9, 3.679041880354011*^9, 3.6790422234937468`*^9, {
   3.679042305168213*^9, 3.6790423215136766`*^9}, 3.679042416275441*^9, 
   3.679043465419634*^9, 3.6791251623787527`*^9, 3.682145594346776*^9}]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"SimplifiedResult", "[", 
   RowBox[{"y_", ",", "yp_", ",", "\[Xi]_", ",", "l_"}], "]"}], "=", 
  RowBox[{"FullSimplify", "[", 
   RowBox[{
    RowBox[{"res", "/.", 
     RowBox[{"replacements", "[", 
      RowBox[{"\[Xi]", ",", "l"}], "]"}]}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{
      RowBox[{"l", ">", "0"}], "&&", 
      RowBox[{"\[Xi]", "\[Element]", "Reals"}]}]}]}], "]"}], " "}]], "Input",
 CellChangeTimes->{{3.682145559360362*^9, 3.682145559832693*^9}}],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["\[ExponentialE]", 
    RowBox[{"-", 
     FractionBox[
      RowBox[{
       RowBox[{"\[ImaginaryI]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"1", "+", 
             SuperscriptBox["l", "4"]}], ")"}], " ", 
           SuperscriptBox["x", "2"]}], "+", 
          RowBox[{"2", " ", "x", " ", "y"}], "-", 
          SuperscriptBox["y", "2"], "-", 
          RowBox[{"2", " ", 
           SuperscriptBox["yp", "2"]}]}], ")"}]}], "+", 
       RowBox[{
        SuperscriptBox["l", "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "2"}], " ", 
              SuperscriptBox["x", "2"]}], "-", 
             RowBox[{"2", " ", "x", " ", "y"}], "+", 
             SuperscriptBox["y", "2"], "+", 
             SuperscriptBox["yp", "2"]}], ")"}], " ", 
           RowBox[{"Cot", "[", "\[Xi]", "]"}]}], "+", 
          RowBox[{"2", " ", "x", " ", "yp", " ", 
           RowBox[{"Csc", "[", "\[Xi]", "]"}]}]}], ")"}]}]}], 
      RowBox[{"2", " ", 
       SuperscriptBox["l", "2"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], "+", 
         RowBox[{
          SuperscriptBox["l", "2"], " ", 
          RowBox[{"Cot", "[", "\[Xi]", "]"}]}]}], ")"}]}]]}]], " ", 
   SqrtBox[
    RowBox[{"\[ImaginaryI]", " ", 
     RowBox[{"Csc", "[", "\[Xi]", "]"}]}]]}], 
  RowBox[{
   SuperscriptBox["l", "2"], " ", "\[Pi]", " ", 
   SqrtBox[
    RowBox[{
     RowBox[{"-", 
      FractionBox["2", 
       SuperscriptBox["l", "2"]]}], "-", 
     RowBox[{"2", " ", "\[ImaginaryI]", " ", 
      RowBox[{"Cot", "[", "\[Xi]", "]"}]}]}]]}]]], "Output",
 CellChangeTimes->{3.682145650506432*^9}]
}, Open  ]],

