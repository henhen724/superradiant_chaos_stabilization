Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"Psi", "[", 
    RowBox[{"x_", ",", "y_", ",", "\[Sigma]_"}], "]"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"2", " ", "\[Pi]"}], "]"}], " ", "\[Sigma]"}]], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        SuperscriptBox["x", "2"], "+", 
        SuperscriptBox["y", "2"]}], 
       RowBox[{"4", " ", 
        SuperscriptBox["\[Sigma]", "2"]}]]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Alpha", "[", 
    RowBox[{
    "x_", ",", "y_", ",", "\[Sigma]_", ",", "fP_", ",", "D0_", ",", 
     "kappa_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"-", 
     FractionBox["1", 
      RowBox[{"D0", "-", 
       RowBox[{"\[ImaginaryI]", " ", "kappa"}]}]]}], "fP", "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        SuperscriptBox["x", "2"], "+", 
        SuperscriptBox["y", "2"]}], 
       RowBox[{"4", " ", 
        SuperscriptBox["\[Sigma]", "2"]}]]}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.7195803924452972`*^9, 3.7195804126764183`*^9}, {
   3.7195806207273006`*^9, 3.71958064007838*^9}, {3.719580821090671*^9, 
   3.719580839281032*^9}, 3.719581007901724*^9}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Alpha", "[", 
    RowBox[{"x_", ",", "y_", ",", "\[Sigma]_", ",", "fP_"}], "]"}], "=", 
   RowBox[{"fP", "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        SuperscriptBox["x", "2"], "+", 
        SuperscriptBox["y", "2"]}], 
       RowBox[{"2", " ", 
        SuperscriptBox["\[Sigma]", "2"]}]]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.722162525477717*^9, 3.722162529381168*^9}, {
