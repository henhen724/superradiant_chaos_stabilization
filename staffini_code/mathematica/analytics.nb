Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "We", " ", "want", " ", "to", " ", "try", " ", "convolving", " ", "the", 
    " ", "kernels", " ", "with", " ", "a", " ", "smoothing", " ", "function", 
    " ", "on", " ", "the", " ", "scale", " ", "of", " ", "the", " ", 
    "lattice", " ", 
    RowBox[{"spacing", " ", "--"}], " ", "here", " ", "take", " ", "a", " ", 
    "Gaussian", " ", "smoothing", " ", "fn", " ", "01"}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"SmoothingFn", "[", 
     RowBox[{"x_", ",", "y_", ",", "xp_", ",", "yp_", ",", "L_"}], "]"}], "=", 
    RowBox[{
     FractionBox["1", 
      RowBox[{"2", " ", "Pi", " ", 
       RowBox[{"L", "^", "2"}]}]], "*", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         RowBox[{
          RowBox[{"(", 
           RowBox[{"x", "-", "y"}], ")"}], "^", "2"}], 
         RowBox[{"2", 
          RowBox[{"L", "^", "2"}]}]]}], "-", 
       FractionBox[
        RowBox[{
         RowBox[{"(", 
          RowBox[{"xp", "-", "yp"}], ")"}], "^", "2"}], 
        RowBox[{"2", 
         RowBox[{"L", "^", "2"}]}]]}], "]"}]}]}], ";"}]}]], "Input",
 CellChangeTimes->{
  3.682145690829212*^9, {3.6987414538271112`*^9, 3.69874154921623*^9}}],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{
   "We", " ", "want", " ", "to", " ", "get", " ", "a", " ", "function", " ", 
    "S"}], "=", 
   RowBox[{"int", " ", "dx", " ", "int", " ", "dxp", " ", "D", 
    RowBox[{"(", 
     RowBox[{"r", ",", 
      RowBox[{"r", "'"}], ",", "\[Xi]"}], ")"}], " ", "Smoothing", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"r", ",", 
       RowBox[{"r", "'"}]}], ")"}], " ", "--"}], " ", "coefficients", " ", 
    "for", " ", "a", " ", "single", " ", "kernel", " ", "contr", " ", "K", 
    RowBox[{"(", 
     RowBox[{"x", ",", "xp", ",", "\[Xi]"}], ")"}], "*", "Smoothing", 
    RowBox[{"(", 
     RowBox[{"x", ",", "xp"}], ")"}], " ", "gotten", " ", "by", " ", "pen", 
    " ", "and", " ", "paper"}]}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.68214572067222*^9, 3.682145730180121*^9}, {
  3.69874193700491*^9, 3.698742035755077*^9}}],

Cell[BoxData[{
 RowBox[{"Clear", "[", "L", "]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Alpha]", "[", 
    RowBox[{"\[Xi]_", ",", "L_"}], "]"}], "=", 
   RowBox[{
    FractionBox["\[ImaginaryI]", 
     RowBox[{"2", " ", 
      RowBox[{"Tan", "[", "\[Xi]", "]"}]}]], "+", 
    FractionBox["1", 
     RowBox[{"2", 
      RowBox[{"L", "^", "2"}]}]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"\[Beta]", "[", 
    RowBox[{"\[Xi]_", ",", "L_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"\[Alpha]", "[", 
     RowBox[{"\[Xi]", ",", "L"}], "]"}], "+", 
    FractionBox["1", 
     RowBox[{"4", "*", 
      RowBox[{"\[Alpha]", "[", 
       RowBox[{"\[Xi]", ",", "L"}], "]"}], "*", 
      RowBox[{
       RowBox[{"Sin", "[", "\[Xi]", "]"}], "^", "2", " "}]}]]}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"A", "[", 
    RowBox[{"\[Xi]_", ",", "L_"}], "]"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", "Pi", " ", 
      SuperscriptBox["L", "2"]}]], "*", 
    RowBox[{"Sqrt", "[", 
     FractionBox[
      RowBox[{"\[ImaginaryI]", "*", "Pi"}], 
      RowBox[{
       RowBox[{"\[Beta]", "[", 
        RowBox[{"\[Xi]", ",", "L"}], "]"}], "*", 
       RowBox[{"\[Alpha]", "[", 
        RowBox[{"\[Xi]", ",", "L"}], "]"}], "*", 
       RowBox[{"Sin", "[", "\[Xi]", "]"}]}]], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"B", "[", 
    RowBox[{"\[Xi]_", ",", "L_"}], "]"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"2", 
      RowBox[{"L", "^", "2"}]}]], "-", 
    FractionBox["1", 
     RowBox[{"4", 
      RowBox[{"L", "^", "4"}], "*", 
      RowBox[{"\[Beta]", "[", 
       RowBox[{"\[Xi]", ",", "L"}], "]"}]}]]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Cc", "[", 
    RowBox[{"\[Xi]_", ",", "L_"}], "]"}], "=", 
   FractionBox[
    RowBox[{"\[ImaginaryI]", " "}], 
    RowBox[{"4", "*", 
     RowBox[{"L", "^", "4"}], "*", 
     RowBox[{"\[Alpha]", "[", 
      RowBox[{"\[Xi]", ",", "L"}], "]"}], "*", 
     RowBox[{"\[Beta]", "[", 
      RowBox[{"\[Xi]", ",", "L"}], "]"}], "*", 
     RowBox[{"Sin", "[", "\[Xi]", "]"}]}]]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"S", "[", 
    RowBox[{"x_", ",", "xp_", ",", "\[Xi]_", ",", "L_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"A", "[", 
     RowBox[{"\[Xi]", ",", "L"}], "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", 
        RowBox[{"B", "[", 
         RowBox[{"\[Xi]", ",", "L"}], "]"}]}], "*", 
       RowBox[{"(", 
        RowBox[{
         SuperscriptBox["x", "2"], "+", 
         SuperscriptBox["xp", "2"]}], ")"}]}], "-", 
      RowBox[{
       RowBox[{"Cc", "[", 
        RowBox[{"\[Xi]", ",", "L"}], "]"}], "*", "x", "*", "xp"}]}], 
     "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.6785152184478083`*^9, 3.6785152203332443`*^9}, {
   3.678522258865361*^9, 3.678522261752836*^9}, {3.678611793644041*^9, 
