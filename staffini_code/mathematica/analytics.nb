Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
   "Sampling", " ", "the", " ", "smoothed", " ", "fn", " ", "discretely"}], 
   " ", "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "L", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"pumpsmoothdisc", "[", 
      RowBox[{"x_", ",", "L_"}], "]"}], "=", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"pump", "[", 
         RowBox[{"x", ",", "xp"}], "]"}], "*", 
        RowBox[{"S", "[", 
         RowBox[{"x", ",", "xp", ",", 
          RowBox[{"Pi", "/", "4"}], ",", "L"}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"xp", ",", 
         RowBox[{"-", "32"}], ",", "32", ",", "L"}], "}"}]}], "]"}]}], 
    ";"}]}]}]], "Input",
 CellChangeTimes->{{3.68214576198025*^9, 3.682145775122826*^9}, {
  3.682145893488185*^9, 3.682145893768673*^9}}],

