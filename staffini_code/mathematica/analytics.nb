}, Open  ]],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"In", " ", "only", " ", "r"}], "*)"}]], "Input",
 CellChangeTimes->{{3.7089397515409193`*^9, 3.708939769960869*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Psi1D", "[", "r_", "]"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"2", " ", "\[Pi]"}], "]"}], " ", "\[Sigma]A"}]], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["r", "2"], 
       RowBox[{"4", " ", 
        SuperscriptBox["\[Sigma]A", "2"]}]]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.707131982229432*^9, 3.7071319859254637`*^9}, {
   3.707132033517645*^9, 3.707132058836033*^9}, {3.707132127714354*^9, 
