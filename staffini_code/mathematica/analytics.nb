   RowBox[{"normalised", ":"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.708939777655437*^9, 3.7089397848490667`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{"r", " ", 
    RowBox[{
     RowBox[{"Psi1D", "[", "r", "]"}], "^", "2"}]}], ",", 
