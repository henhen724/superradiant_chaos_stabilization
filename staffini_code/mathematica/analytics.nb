Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{"Convolution", " ", "X"}], "=", 
   RowBox[{
    RowBox[{"D", 
     RowBox[{"(", "\[Theta]", ")"}], "*"}], "|", "psi", "|", 
    RowBox[{
     RowBox[{"^", "2"}], "*", "D", 
     RowBox[{"(", 
      RowBox[{"-", "\[Theta]"}], ")"}]}]}]}], " ", "*)"}]], "Input",
