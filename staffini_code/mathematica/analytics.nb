Cell[CellGroupData[{

Cell["Rotationally symmetric stuff", "Section",
 CellChangeTimes->{{3.7034245120115767`*^9, 3.7034245243153267`*^9}, {
  3.708778111480446*^9, 3.708778118608232*^9}, {3.7089397099637413`*^9, 
  3.708939721674753*^9}}],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"2", 
   RowBox[{"D", ":"}]}], "*)"}]], "Input",
 CellChangeTimes->{{3.708939733061839*^9, 3.708939740881053*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Psi", "[", 
    RowBox[{"x_", ",", "y_"}], "]"}], "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       RowBox[{"2", " ", "\[Pi]"}], "]"}], " ", "\[Sigma]A"}]], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        SuperscriptBox["x", "2"], "+", 
        SuperscriptBox["y", "2"]}], 
       RowBox[{"4", " ", 
        SuperscriptBox["\[Sigma]A", "2"]}]]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.7071315437184973`*^9, 3.707131660149179*^9}, {
   3.707131894584106*^9, 3.707131894975932*^9}, 3.7071319303748903`*^9, {
   3.709018478502039*^9, 3.709018480309602*^9}, {3.709018585154789*^9, 
   3.7090185856984787`*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[Sigma]A", "=", 
   RowBox[{"Sqrt", "[", "5", "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.707131818417088*^9, 3.7071318321729507`*^9}, {
  3.70867198501493*^9, 3.7086719906534243`*^9}, {3.708672210519908*^9, 
  3.708672210696295*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Integrate", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Psi", "[", 
     RowBox[{"x", ",", "y"}], "]"}], "^", "2"}], ",", 
   RowBox[{"{", 
    RowBox[{"x", ",", 
     RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"y", ",", 
     RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.70713164612971*^9, 3.707131773884007*^9}, {
  3.707131836865624*^9, 3.707131900431715*^9}, {3.707131934278717*^9, 
  3.707131937239777*^9}}],

Cell[BoxData["1"], "Output",
 CellChangeTimes->{
  3.707131937573942*^9, 3.707134151064816*^9, 3.707135697401209*^9, 
   3.707471078105797*^9, 3.7086703409395943`*^9, 3.7086722119758387`*^9, 
