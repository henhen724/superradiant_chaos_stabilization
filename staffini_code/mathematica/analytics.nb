Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "0.01"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"pumpdisc", "[", "x_", "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"pump", "[", 
       RowBox[{"xp", ",", "x"}], "]"}], "*", 
