Cell[CellGroupData[{

Cell["Fixed factors in D(x,x\[CloseCurlyQuote],\[Xi]), comparing magnitudes", \
"Section",
 CellChangeTimes->{{3.71957264558714*^9, 3.719572689098095*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Kern", "[", 
    RowBox[{"x_", ",", "xp_", ",", "\[Xi]_", ",", "\[Gamma]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     FractionBox["1", 
      RowBox[{"\[ImaginaryI]", "*", "Pi", "*", 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Xi]", "+", 
         RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}]}], "]"}]}]], "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      FractionBox["\[ImaginaryI]", "2"], 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"xp", "^", "2"}], "+", 
          RowBox[{"x", "^", "2"}]}], 
         RowBox[{"Tan", "[", 
          RowBox[{"\[Xi]", "+", 
           RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}]}], "]"}]], "-", 
        FractionBox[
         RowBox[{"2", "*", "xp", "*", "x"}], 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Xi]", "+", 
           RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}]}], "]"}]]}], ")"}]}], 
     "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.719572709809277*^9, 3.7195727184173098`*^9}, {
  3.719572766919856*^9, 3.719572784368211*^9}, {3.722154559567975*^9, 
  3.722154562351685*^9}, {3.7221549681105537`*^9, 3.72215497201407*^9}}],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Dkern", "[", 
    RowBox[{
    "x_", ",", "xp_", ",", "y_", ",", "yp_", ",", "\[Xi]_", ",", 
     "\[Gamma]_"}], "]"}], "=", 
   RowBox[{"0.5", "*", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"Kern", "[", 
        RowBox[{"x", ",", "xp", ",", "\[Xi]", ",", "\[Gamma]"}], "]"}], "*", 
       RowBox[{"Kern", "[", 
        RowBox[{"y", ",", "yp", ",", "\[Xi]", ",", "\[Gamma]"}], "]"}]}], "+", 
      RowBox[{
       RowBox[{"Kern", "[", 
        RowBox[{"x", ",", 
         RowBox[{"-", "xp"}], ",", "\[Xi]", ",", "\[Gamma]"}], "]"}], "*", 
       RowBox[{"Kern", "[", 
        RowBox[{"y", ",", 
         RowBox[{"-", "yp"}], ",", "\[Xi]", ",", "\[Gamma]"}], "]"}]}]}], 
     ")"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.719572797446887*^9, 3.719572818246769*^9}, {
  3.722154564023478*^9, 3.7221545646315393`*^9}}],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"XP", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"YY", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"YP", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Xi]P", "=", 
   RowBox[{"Pi", "/", "4"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Gamma]P", "=", 
   RowBox[{
    RowBox[{"-", "1"}], "/", "50"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"GraphicsGrid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{"Kern", "[", 
          RowBox[{"x", ",", "XP", ",", "\[Xi]P", ",", "\[Gamma]P"}], "]"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "12"}], "}"}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "300"}], ",", 
        RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], ",", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Im", "[", 
         RowBox[{"Kern", "[", 
          RowBox[{"x", ",", "XP", ",", "\[Xi]P", ",", "\[Gamma]P"}], "]"}], 
         "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "12"}], "}"}], ",", 
        RowBox[{"PlotStyle", "\[Rule]", "Orange"}], ",", 
        RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], ",", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Kern", "[", 
           RowBox[{"x", ",", "XP", ",", "\[Xi]P", ",", "\[Gamma]P"}], "]"}], 
          "]"}], "^", "2"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "12"}], "}"}], ",", 
        RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
        RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], "}"}], "}"}], ",", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<1D cut of Kernel\>\""}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"GraphicsGrid", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Re", "[", 
         RowBox[{"Dkern", "[", 
          RowBox[{
          "x", ",", "XP", ",", "YY", ",", "YP", ",", "\[Xi]P", ",", 
           "\[Gamma]P"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "12"}], "}"}], ",", 
        RowBox[{"ImageSize", "\[Rule]", "300"}], ",", 
        RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], ",", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"Im", "[", 
         RowBox[{"Dkern", "[", 
          RowBox[{
          "x", ",", "XP", ",", "YY", ",", "YP", ",", "\[Xi]P", ",", 
           "\[Gamma]P"}], "]"}], "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "12"}], "}"}], ",", 
        RowBox[{"PlotStyle", "\[Rule]", "Orange"}], ",", 
        RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], ",", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"Dkern", "[", 
           RowBox[{
           "x", ",", "XP", ",", "YY", ",", "YP", ",", "\[Xi]P", ",", 
            "\[Gamma]P"}], "]"}], "]"}], "^", "2"}], ",", 
        RowBox[{"{", 
         RowBox[{"x", ",", "0", ",", "12"}], "}"}], ",", 
        RowBox[{"PlotStyle", "\[Rule]", "Red"}], ",", 
        RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], "}"}], "}"}], ",", 
   RowBox[{"PlotLabel", "\[Rule]", "\"\<1D cut of Kernel\>\""}]}], 
  "]"}]}], "Input",
