Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"KernCutoff", "[", 
    RowBox[{"x_", ",", "xp_", ",", "\[Xi]_", ",", "\[Gamma]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{"Sqrt", "[", 
     FractionBox["\[ImaginaryI]", 
      RowBox[{"Pi", "*", 
       RowBox[{"Sin", "[", 
        RowBox[{"\[Xi]", "+", 
         RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}]}], "]"}]}]], "]"}], "*", 
    RowBox[{"Exp", "[", 
     RowBox[{
      FractionBox[
       RowBox[{"-", "\[ImaginaryI]"}], "2"], 
      RowBox[{"(", 
       RowBox[{
        FractionBox[
         RowBox[{
          RowBox[{"xp", "^", "2"}], "+", 
          RowBox[{"x", "^", "2"}]}], 
         RowBox[{"Tan", "[", 
          RowBox[{"\[Xi]", "+", 
           RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}]}], "]"}]], "-", 
        FractionBox[
         RowBox[{"2", "*", "xp", "*", "x"}], 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Xi]", "+", 
           RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}]}], "]"}]]}], ")"}]}], 
     "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.6875268727632437`*^9, 3.687526920873376*^9}}],

Cell[BoxData[
 RowBox[{"(*", " ", 
  RowBox[{
   RowBox[{"Convolution", " ", "X"}], "=", 
   RowBox[{
    RowBox[{"D", 
     RowBox[{"(", "\[Theta]", ")"}], "*"}], "|", "psi", "|", 
    RowBox[{
     RowBox[{"^", "2"}], "*", "D", 
     RowBox[{"(", 
      RowBox[{"-", "\[Theta]"}], ")"}]}]}]}], " ", "*)"}]], "Input",
 CellChangeTimes->{{3.6822490543487577`*^9, 3.682249105487005*^9}, 
   3.684487844390491*^9}],

