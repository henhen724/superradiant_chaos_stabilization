Cell[CellGroupData[{

Cell["Checking interaction term for \[Alpha](r) eqn instead", "Section",
 CellChangeTimes->{{3.682232405741371*^9, 3.682232448450781*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "int", " ", "term", " ", "contains", " ", "a", " ", "double", 
     " ", "convolution", " ", "with", " ", "the", " ", "atom", " ", "field", 
     " ", "intensity"}], ",", " ", 
    RowBox[{"which", " ", "is", " ", 
     RowBox[{"smooth", " ", "--"}], " ", "assume", " ", 
     RowBox[{"Gaussian", ".", " ", "We"}], " ", "also", " ", "take", " ", 
     "alpha", " ", "to", " ", "be", " ", "some", " ", "smooth", " ", 
     "function", " ", "to", " ", "compare", " ", "things"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"shiftpsi", "=", "2"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"shiftalpha", "=", 
     RowBox[{"-", "4"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"peakalpha", "=", "5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"\[Sigma]P", "=", "20"}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Psi", "[", 
      RowBox[{"x_", ",", "\[Sigma]_"}], "]"}], "=", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", "Pi", "]"}], " ", "\[Sigma]"}], "]"}]], 
      RowBox[{"(", 
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "-", "shiftpsi"}], ")"}], "^", "2"}], 
          RowBox[{"4", " ", 
           RowBox[{"\[Sigma]", "^", "2"}]}]]}], "]"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"alpha", "[", "xp_", "]"}], "=", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"xp", "-", "shiftalpha"}], ")"}], "^", "2"}]}], "/", "2"}],
        "]"}], "+", 
      RowBox[{"peakalpha", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"xp", "+", "shiftalpha"}], ")"}], "^", "2"}]}], "/", 
         "2"}], "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"Psi", "[", 
      RowBox[{"x", ",", "3"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "20"}], ",", "20"}], "}"}], ",", 
     RowBox[{"PlotLabel", "\[Rule]", "\"\<Psi\>\""}], ",", " ", 
     RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}], "\[IndentingNewLine]", 
   
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"alpha", "[", "x", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "20"}], ",", "20"}], "}"}], ",", 
     RowBox[{"PlotLabel", "\[Rule]", "\"\<alpha\>\""}], ",", 
     RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.6822325042916718`*^9, 3.682232504464329*^9}, {
   3.682232535107669*^9, 3.6822325517352753`*^9}, {3.6822326139816923`*^9, 
   3.682232703940167*^9}, {3.6822331483113537`*^9, 3.68223323113334*^9}, {
   3.68224316746014*^9, 3.682243184210251*^9}, 3.68224735062293*^9, {
   3.682247436715163*^9, 3.682247457410406*^9}, {3.682248692298935*^9, 
   3.682248693637947*^9}, {3.682249150566235*^9, 3.682249219029014*^9}, {
   3.682249439559216*^9, 3.682249442607438*^9}, {3.682249514454692*^9, 
   3.68224951799797*^9}, {3.682249634073642*^9, 3.682249693368141*^9}, {
   3.6822498104299517`*^9, 3.6822498107167664`*^9}, {3.682251240873274*^9, 
