Cell[TextData[{
 "At this point, the integrals look like the following, where we want to do x\
\[CloseCurlyQuote]\[CloseCurlyQuote] and \
y\[CloseCurlyQuote]\[CloseCurlyQuote] next:\n\n",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"=.", ".."}], "-", 
    RowBox[{
     FractionBox[
      SubscriptBox["E", "0"], "4"], 
     FractionBox["1", 
      RowBox[{"16", " ", 
       SuperscriptBox["\[Pi]", "2"], 
       SuperscriptBox["sin", "2"], 
       SubscriptBox["\[Theta]", "0"]}]], 
     RowBox[{"\[Integral]", 
      RowBox[{"\[DifferentialD]", 
       RowBox[{"k", "'"}]}]}]}]}], TraditionalForm]]],
 "\[Alpha](k\[CloseCurlyQuote])\[Integral]\[DifferentialD]r ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{"-", "ikr"}]], TraditionalForm]]],
 " ",
 Cell[BoxData[
  FormBox[
   RowBox[{"exp", "[", 
    RowBox[{
     FractionBox[
      RowBox[{"-", "\[ImaginaryI]"}], 
      RowBox[{"2", " ", "tan", " ", 
       SubscriptBox["\[Theta]", "0"]}]], " ", "*", 
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}], 
      "2"]}]}], TraditionalForm]]],
 "] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"exp", "[", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["\[Sigma]", "2"], 
       RowBox[{"2", 
        SuperscriptBox["sin", "2"], 
        SubscriptBox["\[Theta]", "0"]}]]}], 
     SuperscriptBox[
      RowBox[{"\[LeftBracketingBar]", "r", "\[RightBracketingBar]"}], 
      "2"]}]}], TraditionalForm]],
  FontWeight->"Plain",
  FontVariations->{"Underline"->False}],
 "] ",
 StyleBox["\[Integral]",
  FontWeight->"Bold"],
 "\[DifferentialD]",
 StyleBox["x\[CloseCurlyQuote]\[CloseCurlyQuote] \[Integral]",
  FontWeight->"Bold"],
 "\[DifferentialD]",
 StyleBox["y\[CloseCurlyQuote]\[CloseCurlyQuote] ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{"exp", "[", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["\[Sigma]", "2"], 
       RowBox[{"2", 
        SuperscriptBox["sin", "2"], 
        SubscriptBox["\[Theta]", "0"]}]]}], 
     RowBox[{"(", " ", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"x", "''"}], "2"], "+", 
       RowBox[{"2", "x", " ", 
        RowBox[{"x", "''"}]}]}], ")"}]}]}], TraditionalForm]],
  FontWeight->"Bold",
  FontVariations->{"Underline"->False}],
 StyleBox["]",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{"exp", "[", 
    RowBox[{
     RowBox[{"-", 
      FractionBox[
       SuperscriptBox["\[Sigma]", "2"], 
       RowBox[{"2", " ", 
        SuperscriptBox["sin", "2"], 
        SubscriptBox["\[Theta]", "0"]}]]}], 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"y", "''"}], "2"], "+", 
       RowBox[{"2", " ", "y", " ", 
        RowBox[{"y", "''"}]}]}], ")"}]}]}], TraditionalForm]],
  FontWeight->"Bold",
  FontVariations->{"Underline"->False}],
 StyleBox["] ",
  FontWeight->"Bold"],
 Cell[BoxData[
  FormBox[
   RowBox[{"exp", "[", 
    RowBox[{
     FractionBox["\[ImaginaryI]", 
      RowBox[{"2", " ", "tan", " ", 
       SubscriptBox["\[Theta]", "0"]}]], " ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"x", "''"}], "2"], "+", 
       SuperscriptBox[
        RowBox[{"y", "''"}], "2"]}], ")"}]}]}], TraditionalForm]],
  FontWeight->"Bold",
  FontVariations->{"Underline"->False}],
 StyleBox["]",
  FontWeight->"Bold"],
 " ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["e", 
    RowBox[{
     RowBox[{
      SubscriptBox["ik", "x"], 
      RowBox[{"x", "''"}]}], "+", 
     RowBox[{
      SubscriptBox["ik", "y"], 
      RowBox[{"y", "''"}]}]}]], TraditionalForm]],
  FontWeight->"Bold"],
 "\n"
}], "Text",
