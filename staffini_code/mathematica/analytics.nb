Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"L", "=", "0.2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mult", "=", 
   RowBox[{"1", "/", "30"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ls", "=", "16"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Xdisc", "[", 
    RowBox[{"x_", ",", "xp_", ",", "\[Theta]_"}], "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{"L", "*", 
      RowBox[{"Kern1D", "[", 
       RowBox[{"x", ",", "xpp", ",", "\[Theta]"}], "]"}], "*", 
      RowBox[{
       RowBox[{"Abs", "[", 
        RowBox[{"Psi", "[", 
         RowBox[{"xpp", ",", "\[Sigma]P"}], "]"}], "]"}], "^", "2"}], "*", 
      RowBox[{"Kern1D", "[", 
       RowBox[{"xpp", ",", "xp", ",", 
        RowBox[{"-", "\[Theta]"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"xpp", ",", 
       RowBox[{"-", "ls"}], ",", "ls", ",", "L"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Xdisctable", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"Re", "[", 
        RowBox[{"Xdisc", "[", 
         RowBox[{"x", ",", "0", ",", " ", 
          RowBox[{"\[Pi]", "/", "4"}]}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"x", ",", 
       RowBox[{"-", "ls"}], ",", "ls", ",", "L"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"ListPlot", "[", "Xdisctable", "]"}], ",", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"Re", "[", 
       RowBox[{"X", "[", 
        RowBox[{"x", ",", "0", ",", 
         RowBox[{"Pi", "/", "4"}], ",", "\[Sigma]P"}], "]"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "ls"}], ",", "ls"}], "}"}]}], "]"}]}], "}"}], 
  "]"}], "\[IndentingNewLine]"}], "Input",
