Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"to", " ", "only", " ", "keep", " ", "even", " ", "m"}], "+", 
     RowBox[{"n", " ", "modes"}]}], ",", " ", 
    RowBox[{
    "we", " ", "need", " ", "to", " ", "make", " ", "the", " ", "kernel", " ",
      "with", " ", "the", " ", "correct", " ", "parity"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"KernCutoff", "[", 
      RowBox[{"x_", ",", "xp_", ",", "\[Xi]_", ",", "\[Gamma]_"}], "]"}], "=", 
     RowBox[{
      RowBox[{"Sqrt", "[", 
       FractionBox["\[ImaginaryI]", 
        RowBox[{"2", "*", "Pi", "*", 
         RowBox[{"Sin", "[", 
          RowBox[{"\[Xi]", "+", 
           RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}]}], "]"}]}]], "]"}], "*", 
      RowBox[{"Exp", "[", 
       RowBox[{
        FractionBox[
         RowBox[{"-", "\[ImaginaryI]"}], "2"], 
        RowBox[{"(", 
         RowBox[{
          FractionBox[
           RowBox[{
            RowBox[{"xp", "^", "2"}], "+", 
            RowBox[{"x", "^", "2"}]}], 
           RowBox[{"Tan", "[", 
            RowBox[{"\[Xi]", "+", 
             RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}]}], "]"}]], "-", 
          FractionBox[
           RowBox[{"2", "*", "xp", "*", "x"}], 
           RowBox[{"Sin", "[", 
            RowBox[{"\[Xi]", "+", 
             RowBox[{"\[ImaginaryI]", " ", "\[Gamma]"}]}], "]"}]]}], ")"}]}], 
       "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"KernEven", "[", 
      RowBox[{
      "x_", ",", "xp_", ",", "y_", ",", "yp_", ",", "\[Xi]_", ",", 
       "\[Gamma]_"}], "]"}], "=", 
     RowBox[{"0.5", "*", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"KernCutoff", "[", 
          RowBox[{"x", ",", "xp", ",", "\[Xi]", ",", "\[Gamma]"}], "]"}], "*", 
         RowBox[{"KernCutoff", "[", 
          RowBox[{"y", ",", "yp", ",", "\[Xi]", ",", "\[Gamma]"}], "]"}]}], 
        "+", 
        RowBox[{
         RowBox[{"KernCutoff", "[", 
          RowBox[{"x", ",", 
           RowBox[{"-", "xp"}], ",", "\[Xi]", ",", "\[Gamma]"}], "]"}], "*", 
         RowBox[{"KernCutoff", "[", 
          RowBox[{"y", ",", 
           RowBox[{"-", "yp"}], ",", "\[Xi]", ",", "\[Gamma]"}], "]"}]}]}], 
       ")"}]}]}], ";"}]}]}]], "Input",
