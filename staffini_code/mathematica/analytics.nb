Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"X", "[", 
   RowBox[{"x_", ",", "xp_", ",", "\[Theta]_", ",", "\[Sigma]_"}], "]"}], "=", 
  RowBox[{"Integrate", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Kern1D", "[", 
      RowBox[{"x", ",", "xpp", ",", "\[Theta]"}], "]"}], "*", 
     RowBox[{
      RowBox[{"Abs", "[", 
       RowBox[{"Psi", "[", 
        RowBox[{"xpp", ",", "\[Sigma]"}], "]"}], "]"}], "^", "2"}], "*", 
     RowBox[{"Kern1D", "[", 
      RowBox[{"xpp", ",", "xp", ",", 
       RowBox[{"-", "\[Theta]"}]}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"xpp", ",", 
      RowBox[{"-", "\[Infinity]"}], ",", "\[Infinity]"}], "}"}], ",", 
    RowBox[{"Assumptions", "\[Rule]", 
     RowBox[{
      RowBox[{"\[Sigma]", " ", "\[Element]", "Reals"}], "&&", 
      RowBox[{"\[Sigma]", ">", "0"}]}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.682233235187072*^9, 3.6822334231759167`*^9}, {
