Cell["\[Alpha](r) with mode cutoff, smoothing, even modes only", "Section",
 CellChangeTimes->{{3.698740964272717*^9, 3.698740981288272*^9}}],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
    "The", " ", "int", " ", "term", " ", "contains", " ", "a", " ", "double", 
     " ", "convolution", " ", "with", " ", "the", " ", "atom", " ", "field", 
     " ", "intensity"}], ",", " ", 
    RowBox[{"which", " ", "is", " ", 
     RowBox[{"smooth", " ", "--"}], " ", "assume", " ", 
     RowBox[{"Gaussian", ".", " ", "We"}], " ", "also", " ", "take", " ", 
     "alpha", " ", "to", " ", "be", " ", "some", " ", "smooth", " ", 
     "function", " ", "to", " ", "compare", " ", "things"}]}], " ", "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"Clear", "[", "\[Sigma]", "]"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"shiftpsi", "=", "0"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"shiftalpha", "=", 
     RowBox[{"-", "4"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"peakalpha", "=", "5"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"\[Sigma]P", "=", "20"}], ";"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"Psi", "[", 
      RowBox[{"x_", ",", "\[Sigma]_"}], "]"}], "=", 
     RowBox[{
      FractionBox["1", 
       RowBox[{"Sqrt", "[", 
        RowBox[{
         RowBox[{"Sqrt", "[", "Pi", "]"}], " ", "\[Sigma]"}], "]"}]], 
      RowBox[{"(", 
       RowBox[{"Exp", "[", 
        RowBox[{"-", 
         FractionBox[
          RowBox[{
           RowBox[{"(", 
            RowBox[{"x", "-", "shiftpsi"}], ")"}], "^", "2"}], 
          RowBox[{"4", " ", 
           RowBox[{"\[Sigma]", "^", "2"}]}]]}], "]"}], ")"}]}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"alpha", "[", "xp_", "]"}], "=", 
     RowBox[{
      RowBox[{"Exp", "[", 
       RowBox[{
        RowBox[{"-", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"xp", "-", "shiftalpha"}], ")"}], "^", "2"}]}], "/", "2"}],
        "]"}], "+", 
      RowBox[{"peakalpha", "*", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"xp", "+", "shiftalpha"}], ")"}], "^", "2"}]}], "/", 
         "2"}], "]"}]}]}]}], ";"}], "\n", 
   RowBox[{"plot2", "=", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Psi", "[", 
         RowBox[{"x", ",", 
          RowBox[{"Sqrt", "[", "20", "]"}]}], "]"}], ",", 
        RowBox[{"alpha", "[", "x", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"-", "20"}], ",", "20"}], "}"}], ",", 
      RowBox[{"PlotLegends", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<Psi\>\"", ",", "\"\<alpha\>\""}], "}"}]}], ",", " ", 
      RowBox[{"PlotRange", "\[Rule]", "All"}]}], "]"}]}], 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Export", "[", 
     RowBox[{"\"\<wavefns.png\>\"", ",", "plot2"}], "]"}], 
    "*)"}]}]}]], "Input",
